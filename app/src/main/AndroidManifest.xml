<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for Supabase HTTPS calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- System notifications (Android 13+). The runtime prompt is launched the
         first time the user reaches the Groups screen after logging in. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera capture (avatar / group / expense receipt). The runtime prompt
         is launched on-demand when the user picks "Take a photo" from the
         image-source bottom sheet — see `ImageSourcePicker`. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".EquiShareApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EquiShare"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="tiramisu">
        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:theme="@style/Theme.App.Starting"
            tools:targetApi="tiramisu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link from Supabase Auth email confirmation / password reset. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="equishare"
                    android:host="login-callback" />
            </intent-filter>
        </activity>

        <!-- FileProvider used to share a temp file Uri with the camera app
             when capturing avatar / group / receipt photos. The authority
             matches the one referenced by `ImageSourcePicker`. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Cloud Messaging service. Receives push payloads even when
             the app is fully killed (Android keeps a system-level channel open
             on behalf of all apps registered with FCM). -->
        <service
            android:name=".data.remote.EquiShareFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default small icon used by FCM when no other is provided in the
             notification payload. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/equishare_logo" />
        <!-- Default channel for FCM-rendered notifications (used only when we
             accidentally send a "notification" payload instead of pure data). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general_channel" />
    </application>

</manifest>
